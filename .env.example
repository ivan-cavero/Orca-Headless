# Orca Headless Docker — copy to .env and edit.
#   cp .env.example .env
#
# Docker Compose reads this file automatically.

# ---------------------------------------------------------------------------
# Required for any client that is not running inside this container
# ---------------------------------------------------------------------------
# The address a client uses to dial this server. It is advertised, not bound:
# Orca still listens on 0.0.0.0 inside the container.
#
#   VPS with a public IP ......... 203.0.113.10
#   Tailscale .................... 100.64.1.20
#   DNS name ..................... orca.mydomain.dev
#   Behind a TLS reverse proxy ... https://orca.example.com/runtime
#
# Leaving this at 127.0.0.1 produces a pairing URL that only works from inside
# the container. Wildcards (0.0.0.0, *) are rejected by Orca.
ORCA_PAIRING_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Host and container port for the Orca runtime.
ORCA_PORT=6768

# Published image. Change this if you forked the repository.
ORCA_IMAGE=ghcr.io/ivan-cavero/orca-headless:latest

# UID/GID the container runs as. Must match the image's build-time PUID/PGID
# (default 1000:1000). See "Changing PUID / PGID" in the README.
PUID=1000
PGID=1000

# Host directory mounted at /home/orca/workspace inside the container.
# Create it before the first start so it is owned by you: mkdir -p ./workspace
ORCA_WORKSPACE=./workspace

# SELinux label for the workspace bind mount. Leave empty on Ubuntu, Debian and
# anything else without SELinux. On Fedora / RHEL / CentOS set it to :z, or the
# container cannot write to the mounted directory.
ORCA_SELINUX_LABEL=

# Orca release to bake into the image. Only read by docker-compose.build.yml
# when you build locally; the published image already pins its own version.
ORCA_VERSION=v1.4.206

# true  -> emit {"type":"orca_server_ready","schemaVersion":1,...} (recommended,
#          this is the contract the healthcheck parses)
# false -> emit the human-readable "Orca server ready" block
ORCA_JSON=true

# Chromium's sandbox cannot initialise in a default container. Leaving this true
# is the only configuration that works out of the box; read "About --no-sandbox"
# in the README before changing it.
ORCA_NO_SANDBOX=true

# Extra flags appended verbatim to `orca serve`, for example:
#   ORCA_EXTRA_ARGS=--mobile-pairing
ORCA_EXTRA_ARGS=
