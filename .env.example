# Orca Headless Docker — copy to .env and edit.
#   cp .env.example .env
#
# Docker Compose reads this file automatically. Dokploy writes the variables you
# set in its Environment tab to the same .env file.
#
# Only ORCA_PAIRING_ADDRESS matters before you connect from another machine.
# Everything else has a working default.

# ---------------------------------------------------------------------------
# Required for any client that is not running inside this container
# ---------------------------------------------------------------------------
# The address a client uses to dial this server. It is advertised, not bound:
# Orca still listens on 0.0.0.0 inside the container.
#
#   VPS with a public IP ......... 203.0.113.10
#   Tailscale .................... 100.64.1.20
#   DNS name ..................... orca.mydomain.dev
#   Behind a TLS reverse proxy ... https://orca.example.com/runtime
#
# Leaving this at 127.0.0.1 produces a pairing URL that only works from inside
# the container. Wildcards (0.0.0.0, *) are rejected by Orca.
#
# Add an explicit :port only when something else owns the port, e.g. a reverse
# proxy on 443. Otherwise the entrypoint appends ORCA_HOST_PORT for you.
ORCA_PAIRING_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Where Orca keeps everything (optional)
# ---------------------------------------------------------------------------
# Leave empty for a named Docker volume at /home/orca. That is the default and
# it needs no host directory at all: state, worktree checkouts and repositories
# all persist inside it.
#
# Set it to an ABSOLUTE HOST PATH to store everything in a real host directory
# instead, mounted at its own path so container paths and host paths are
# identical. Create it first and make it yours:
#
#   sudo mkdir -p /srv/orca/home
#   sudo chown -R "$(id -u):$(id -g)" /srv/orca/home
#
# Do not use a relative path. On Dokploy leave this empty: Dokploy cleans up
# absolute host paths between deployments.
# ORCA_HOME_DIR=/srv/orca/home

# SELinux label for the mount above. Leave empty on Ubuntu, Debian and anything
# else without SELinux. On Fedora / RHEL / CentOS set it to :z when you set
# ORCA_HOME_DIR, or the label blocks writes even though Unix permissions look
# correct. Has no effect while ORCA_HOME_DIR is empty.
ORCA_SELINUX_LABEL=

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

# Port Orca listens on inside the container.
ORCA_PORT=6768

# Port published on the host. Leave it equal to ORCA_PORT unless 6768 is taken
# on the host — the entrypoint uses this value to build the advertised pairing
# URL, so changing it here is enough to keep clients reachable.
ORCA_HOST_PORT=6768

# ---------------------------------------------------------------------------
# Image and identity
# ---------------------------------------------------------------------------

# Published image. Change this if you forked the repository.
ORCA_IMAGE=ghcr.io/ivan-cavero/orca-headless:latest

# UID/GID the container runs as. Must match the image's build-time PUID/PGID
# (default 1000:1000), and the owner of ORCA_HOME_DIR when you set it.
# The container's internal account name is cosmetic — only the numbers matter.
PUID=1000
PGID=1000

# Orca release to bake into the image. Only read by docker-compose.build.yml
# when you build locally; the published image already pins its own version.
ORCA_VERSION=v1.4.210

# Extra apt packages baked into the image, space-separated. Only read by
# docker-compose.build.yml. Example: "gnupg2 pass" for a keyring.
ORCA_EXTRA_PACKAGES=

# Node.js version to install in the image, from nodejs.org. Empty means no Node.
# Set it when you need `orca skills install` or want to install agent CLIs with
# npm: Ubuntu 24.04's own nodejs is 18, and the community `skills` CLI requires
# >= 22.20. Costs about 200 MB, so it is off by default.
#   NODE_VERSION=24.21.0
NODE_VERSION=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# true  -> emit {"type":"orca_server_ready","schemaVersion":1,...} (recommended,
#          this is the contract the healthcheck parses)
# false -> emit the human-readable "Orca server ready" block, and a scannable
#          QR code when --mobile-pairing is on
ORCA_JSON=true

# Chromium's sandbox cannot initialise in a default container. Leaving this true
# is the only configuration that works out of the box; read "About --no-sandbox"
# in the README before changing it.
ORCA_NO_SANDBOX=true

# Extra flags appended verbatim to `orca serve`, for example:
#   ORCA_EXTRA_ARGS=--mobile-pairing
#
# --mobile-pairing REPLACES the runtime pairing link with a mobile-scoped one:
# you get one or the other, not both. A desktop client cannot use a mobile code,
# so turn it on only when you are pairing a phone. Set ORCA_JSON=false to get
# the scannable QR in the logs.
#
#   ORCA_EXTRA_ARGS=--no-pairing    disables pairing entirely
ORCA_EXTRA_ARGS=
