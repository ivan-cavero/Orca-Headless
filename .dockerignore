# Build context for the Docker image.
# Everything not required by the Dockerfile is excluded, which keeps the build
# context tiny and guarantees local secrets never reach the daemon.

# Version control
.git
.gitignore
.gitattributes

# Local configuration and secrets — never send these to the build daemon
.env
.env.*
!.env.example

# Documentation and repository metadata.
# LICENSE and NOTICE are NOT excluded: the image installs both, and Orca's own
# MIT notice has to travel with the copy of Orca the image redistributes.
*.md
.github

# Local compose overrides and scratch state
docker-compose*.yml
workspace

# Editor / OS noise
.vscode
.idea
*.swp
.DS_Store
Thumbs.db
